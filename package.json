{
  "name": "imakol-api-proxy",
  "version": "1.0.0",
  "description": "A proxy server for handling image enhancement API requests and avoiding CORS errors",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "setup": "node install.js",
    "setup-collections": "node setup/collections.js",
    "test-pb": "node test/test-pocketbase.js",
    "init-pb": "node setup/initialize-pocketbase.js",
    "check-pb": "node test/check-pocketbase.js",
    "test-auth": "node test/test-auth-routes.js",
    "test-auth-with-server": "powershell -Command \"$env:NODE_ENV='test'; start-process node -ArgumentList 'server.js' -NoNewWindow; sleep 2; node test/test-auth-routes.js\"",
    "security-audit": "node server/tools/security-audit.js",
    "build": "cp -r index.html styles.css www/",
    "sync": "npx cap sync",
    "open:ios": "npx cap open ios",
    "open:android": "npx cap open android",
    "build:ios": "npm run build && npx cap sync ios",
    "build:android": "npm run build && npx cap sync android"
  },
  "dependencies": {
    "@capacitor/android": "7.1.0",
    "@capacitor/camera": "7.0.0",
    "@capacitor/cli": "7.1.0",
    "@capacitor/core": "7.1.0",
    "@capacitor/ios": "7.1.0",
    "axios": "1.8.4",
    "canvas": "3.1.0",
    "cookie-parser": "1.4.7",
    "cors": "^2.8.5",
    "csurf": "1.10.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "7.5.0",
    "express-session": "1.18.1",
    "express-validator": "7.2.1",
    "form-data": "4.0.2",
    "helmet": "7.2.0",
    "multer": "^1.4.5-lts.1",
    "pocketbase": "github:pocketbase/js-sdk",
    "winston": "3.17.0"
  },
  "devDependencies": {
    "node-fetch": "3.3.2",
    "nodemon": "^3.0.2"
  }
}